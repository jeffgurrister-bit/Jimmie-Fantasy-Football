# Workbooks are large, so they stay out of git by default — point the tools at a
# local path instead. The one exception is data/workbook/, which is how the
# commissioner uploads a new copy through GitHub's website without needing a
# terminal: the update workflow reads whatever lands there.
*.xlsx
*.xlsm
!data/workbook/*.xlsx
# Spreadsheets pulled down by the Read Google Sheets workflow — inspection only.
downloaded-*.xlsx
!docs/fixtures/**/*.xlsx

.DS_Store
.vercel
coverage/
