{
  "name": "jimmie-fantasy-football",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "sync": "pnpm --filter @jff/sync sync",
    "backfill": "pnpm --filter @jff/sync backfill",
    "migrate": "pnpm --filter @jff/db migrate",
    "dev": "pnpm --filter @jff/rbb dev",
    "verify": "pnpm --filter @jff/sync run verify",
    "snapshot": "pnpm --filter @jff/sync run snapshot"
  }
}
