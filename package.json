{
  "name": "jimmie-fantasy-football",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "sync": "pnpm --filter @jff/sync sync",
    "backfill": "pnpm --filter @jff/sync backfill",
    "migrate": "pnpm --filter @jff/db migrate"
  }
}
