# Postgres — OPTIONAL. The website does not use it; it reads a committed snapshot.
# Only needed for the tools and for future features that want live queries.
# Any Postgres works (Neon, Supabase, local) — it is just a connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Path to the commissioner's workbook, for the one-time historical backfill.
# The workbook is not committed — it is large and private.
RBB_WORKBOOK_PATH=/path/to/RBB_League_History.xlsx

# Secret in the /admin/sync refresh URL. Long and random; it is the only thing
# protecting the endpoint.
SYNC_TOKEN=
